{
  "name": "@ouds/icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/icons/src",
  "projectType": "library",
  "tags": ["lib:icons"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "outputPath": "dist/libs/icons"
      },
      "dependsOn": ["^build"]
    },
    "generate-icons": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/icons.config.json",
        "{projectRoot}/scripts/generate-icons.mjs",
        "{workspaceRoot}/libs/web/site/static/*/docs/*/assets/img/ouds-web-sprite.svg"
      ],
      "outputs": ["{projectRoot}/src/icons", "{projectRoot}/src/index.ts"],
      "options": {
        "command": "node scripts/generate-icons.mjs",
        "cwd": "libs/icons"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/libs/web/site/static/*/docs/*/assets/img/ouds-web-sprite.svg"
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --coverage",
        "cwd": "libs/icons"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
