    "watch": "npm run watch -w libs/web",
    "watch-js-main": "npm run watch-js-main -w libs/web",
    "watch-js-docs": "npm run watch-js-docs -w libs/web",
    "storybook": "npm run storybook -w libs/web",
    "storybook-generate": "npm run storybook-generate -w libs/web",
    "storybook-build": "npm run storybook-build -w libs/web",
    "update-composite-icons": "npm run update-composite-icons -w libs/web",
    "update-sprite-icons": "npm run update-sprite-icons -w libs/web"
  },
  "devDependencies": {
    "nx": "^23.2.0",
    "npm-run-all2": "^9.0.3",
    "lockfile-lint": "^5.0.1"
  }
