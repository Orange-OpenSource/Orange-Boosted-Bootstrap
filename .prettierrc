{
  "semi": true,
  "endOfLine": "lf",
  "trailingComma": "all",
  "singleQuote": true,
  "quoteProps": "consistent",
  "bracketSpacing": true,
  "arrowParens": "always",
  "jsxSingleQuote": true,
  "overrides": [
    {
      "files": "*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,vue,html,css,scss,less}",
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
