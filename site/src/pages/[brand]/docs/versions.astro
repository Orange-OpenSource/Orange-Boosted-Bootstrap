---
import SingleLayout from '@layouts/SingleLayout.astro'
import { getConfig } from '@libs/config'
import { getData } from '@libs/data'

function getVersionsSortedDesc<TKey extends string, TVersions extends Record<TKey, string>>(
  versions: TVersions[],
  orderBy: TKey
) {
  return [...versions].sort((versionA, versionB) => {
    return versionB[orderBy].localeCompare(versionA[orderBy])
  })
}

export function getStaticPaths() {
  return [
    {
      params: { brand: getConfig().brand }
    }
  ]
}
---

<SingleLayout title="Versions" description="An appendix of hosted documentation for nearly every release of OUDS Web.">
  <div class="row">
    {
      getVersionsSortedDesc(getData('docs-versions'), 'group').map((docsVersion) => {
        return (
          <div class="md:col-6 lg:col-4 xl:col mb-2xlarge">
            <h2>{docsVersion.group}</h2>
            <p>{docsVersion.description}</p>
            <ul class="item-list component-max-width">
              {docsVersion.versions
                .slice()
                .sort((a, b) => b.localeCompare(a))
                .map((version) => {
                  const isCurrentVersion = version === getConfig().docs_version

                  return (
                    <li class="item item-navigation">
                      <a class="item-container item-interactive" href={`${docsVersion.baseurl.replaceAll('[brand]', getConfig().brand)}/${version}/`}>
                        <div class="item-content">
                          <div class="item-text-container">
                            <span class="item-label">{version}</span>
                          </div>
                          {isCurrentVersion && <div class="item-trailing-container">
                            <span class="tag tag-accent">Latest</span>
                          </div>}
                        </div>
                      </a>
                    </li>
                  )
                })}
            </ul>
          </div>
        )
      })
    }
  </div>
</SingleLayout>
