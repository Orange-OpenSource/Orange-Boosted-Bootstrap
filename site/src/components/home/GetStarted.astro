---
import { getConfig } from '@libs/config'
import { getVersionedDocsPath } from '@libs/path'
import Code from '@components/shortcodes/Code.astro'
---

<section class="row pb-scaled-xlarge">
  <div class="col-12 d-none xl:d-block pb-scaled-small">
    <hr class="border-medium border-default m-none" />
  </div>
  <div class="xl:col-4 xl:pe-5xlarge">
    <hr class="xl:d-none border-medium m-none pb-scaled-small" />
    <h2 class:list={[getConfig().brand === 'sosh' ? 'text-brand-primary' : 'marker', 'mb-scaled-xsmall']}>Get started any way you&nbsp;want</h2>
    <p class="lead fw-bold bd-text-wrap-balance mb-scaled-xsmall">
      Jump right into building with OUDS Web—install it via your favorite package manager, or equip your AI coding agent with ready-to-use Skills.
    </p>
    <p class="mb-scaled-large">
      <a href={getVersionedDocsPath('getting-started/download')} class="link link-chevron"> Read installation docs</a>
    </p>
  </div>
  <div class="xl:col-8">
    <h3 class="mb-scaled-xsmall">Install via package manager</h3>
    <p class="mb-scaled-medium">
      Install OUDS Web's source files via npm, yarn, Composer, or NuGet. Package-managed installs include OUDS Web common Sass and
      JavaScript files and OUDS Web {getConfig().display_brand} theme (Sass files). They don't include documentation or our full build
      scripts.
    </p>
    <Code
      code={`npm install @ouds/web-common@${getConfig().current_version} @ouds/web-${getConfig().brand}@${getConfig().current_version}`}
      lang="sh" buttonLabel="npm install"
    />
    <Code
      code={`yarn add @ouds/web-common@${getConfig().current_version} @ouds/web-${getConfig().brand}@${getConfig().current_version}`}
      lang="sh" buttonLabel="yarn install"
    />
    <p class="mb-scaled-large">
      <a href={getVersionedDocsPath('getting-started/download')}>Read our installation docs</a> for more info and additional
      package managers.
    </p>
    <div class="border-top border-thin border-default pt-scaled-small">
      <h3>Use with AI coding agents</h3>
      <p class="mb-scaled-medium">
        OUDS Web ships Agent Skills that give AI coding agents (Claude Code, Cursor, GitHub Copilot, and others)
        procedural knowledge of the design system, such as correct component markup, layout and utility classes,
        design tokens, and migration steps.
      </p>
      <Code
        code="npx skills add Orange-OpenSource/Orange-Boosted-Bootstrap/skills"
        lang="sh" buttonLabel="npx skills add"
      />
      <p class="mb-none">
        Learn more about <a
          href={getVersionedDocsPath('getting-started/introduction/#using-ouds-web-with-ai-coding-agents')}
          >using OUDS Web with AI coding agents</a
        >.
      </p>
    </div>
  </div>
</section>
