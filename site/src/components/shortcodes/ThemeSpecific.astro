---
import { getConfig } from '@libs/config';
/*
 * Outputs badge to identify the first version something was added
 */
interface Props {
  /**
   * The theme(s) that should display the following part.
   */
  theme?: string | string[]
}

const { theme = 'orange' } = Astro.props

const themeToDisplay: string[] = typeof theme === 'string' ? [theme] : theme
---

{themeToDisplay.map((theme) => {
  if (theme === getConfig().brand) {
    return <slot />
  }
})}
